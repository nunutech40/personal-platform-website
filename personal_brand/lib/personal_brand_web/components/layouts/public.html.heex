<div class={["public-site", @theme_class]}>
  <div class="shell">
    <header class="site-header">
      <div>
        <p class="site-title"><a href="/">{@profile_name}</a></p>
        <p :if={present?(@profile_title)} class="tagline">{@profile_title}</p>
        <div :if={@ordered_social_links != []} class="social-links">
          <%= for {{label, url}, index} <- Enum.with_index(@ordered_social_links) do %>
            <span :if={index > 0}>|</span>
            <a href={url}>{label}</a>
          <% end %>
        </div>
      </div>
      <nav class="text-nav" aria-label="Primary">
        <a href="/">Home</a><span>|</span>
        <a href="/work">Work</a><span>|</span>
        <a href="/writing">Writing</a><span>|</span>
        <a href="/products">Products</a><span>|</span>
        <a href="/about">About</a><span>|</span>
        <a href="/now">Now</a><span>|</span>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <hr />
    <main>
      {@inner_content}
    </main>
    <footer class="footer">
      <hr />
      <div :if={@ordered_social_links != []} class="footer-connect">
        <strong>Let's connect:</strong>
        <div class="footer-links">
          <%= for {{label, url}, index} <- Enum.with_index(@ordered_social_links) do %>
            <span :if={index > 0} aria-hidden="true">|</span>
            <a href={url}>{label}</a>
          <% end %>
        </div>
      </div>
      <p class="meta">© 2026 {@profile_name}. Built with Phoenix LiveView.</p>
    </footer>
  </div>
</div>
