<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Admin · Nunu Nugraha" suffix=" · Personal Brand">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div class="min-h-screen bg-base-200">
      <div class="drawer lg:drawer-open">
        <input id="admin-drawer" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content flex flex-col">
          <!-- Navbar -->
          <div class="navbar bg-base-100 border-b border-base-300 lg:hidden">
            <div class="flex-none">
              <label for="admin-drawer" class="btn btn-square btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              </label>
            </div>
            <div class="flex-1">
              <a href="/admin" class="text-xl font-bold">Admin</a>
            </div>
            <div class="flex-none">
              <a href="/admin/logout" class="btn btn-ghost btn-sm">Logout</a>
            </div>
          </div>
          <!-- Page content -->
          <div class="p-4">
            {@inner_content}
          </div>
        </div>
        <div class="drawer-side">
          <label for="admin-drawer" class="drawer-overlay"></label>
          <aside class="bg-base-100 min-h-screen w-64 border-r border-base-300">
            <div class="p-4 border-b border-base-300 hidden lg:flex items-center justify-between">
              <a href="/admin" class="text-xl font-bold">Admin</a>
              <a href="/admin/logout" class="btn btn-ghost btn-xs">Logout</a>
            </div>
            <ul class="menu p-4">
              <li class="menu-title">Content</li>
              <li><a href="/admin/projects">Projects</a></li>
              <li><a href="/admin/posts">Posts</a></li>
              <li><a href="/admin/products">Products</a></li>
              <li><a href="/admin/media">Media</a></li>
              <li class="menu-title mt-4">Settings</li>
              <li><a href="/admin/site-settings">Site Settings</a></li>
              <li><a href="/admin/themes">Themes</a></li>
              <li class="menu-title mt-4">Site</li>
              <li><a href="/" target="_blank">View Site</a></li>
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
