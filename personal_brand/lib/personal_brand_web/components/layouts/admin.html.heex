<Backpex.HTML.Layout.app_shell
  fluid={assigns[:fluid?] || true}
  live_resource={assigns[:live_resource]}
  class="admin-shell min-h-screen bg-slate-100 text-slate-900"
>
  <:topbar class="admin-topbar border-slate-200 bg-white">
    <div class="flex w-full items-center justify-between gap-4">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
          Personal Brand CMS
        </p>
        <div class="truncate text-sm font-medium text-slate-500 sm:text-base">
          {admin_breadcrumb(assigns)}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <.link
          navigate={~p"/"}
          class="btn btn-sm btn-outline border-blue-200 text-blue-700 hover:border-blue-300 hover:bg-blue-50"
        >
          Preview
        </.link>
        <.link
          href={~p"/admin/logout"}
          class="btn btn-sm border-blue-600 bg-blue-600 text-white hover:border-blue-700 hover:bg-blue-700"
        >
          Logout
        </.link>
      </div>
    </div>
  </:topbar>

  <:sidebar class="admin-sidebar bg-slate-950 text-slate-300">
    <li class="px-4 py-5">
      <.link navigate={~p"/admin"} class="block no-underline">
        <span class="block text-2xl font-bold tracking-normal text-white">Nunu Admin</span>
        <span class="mt-1 block text-sm font-medium text-slate-400">Personal Brand CMS</span>
      </.link>
    </li>

    <li class="menu-title px-4 pt-4 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
      Content
    </li>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin"}
    >
      <.icon name="hero-squares-2x2" class="size-5" /> Dashboard
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/projects"}
    >
      <.icon name="hero-briefcase" class="size-5" /> Projects
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/posts"}
    >
      <.icon name="hero-document-text" class="size-5" /> Posts
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/products"}
    >
      <.icon name="hero-shopping-bag" class="size-5" /> Products
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/media"}
    >
      <.icon name="hero-photo" class="size-5" /> Media
    </Backpex.HTML.Layout.sidebar_item>

    <li class="menu-title px-4 pt-6 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
      Settings
    </li>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/site-settings"}
    >
      <.icon name="hero-adjustments-horizontal" class="size-5" /> Site Settings
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item
      current_url={admin_current_url(assigns)}
      navigate={~p"/admin/themes"}
    >
      <.icon name="hero-swatch" class="size-5" /> Themes
    </Backpex.HTML.Layout.sidebar_item>

    <li class="menu-title px-4 pt-6 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
      Commerce
    </li>
    <li>
      <span class="cursor-not-allowed gap-3 px-4 text-slate-500">
        <.icon name="hero-receipt-percent" class="size-5" /> Orders (later)
      </span>
    </li>
  </:sidebar>

  <Backpex.HTML.Layout.flash_messages flash={assigns[:flash] || %{}} />
  <div class="admin-page">
    {render_slot(@inner_block)}
  </div>
</Backpex.HTML.Layout.app_shell>
