<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <.live_title default="Nunu Nugraha" suffix=" · Personal Brand" phx-no-format>{assigns[:page_title]}</.live_title>

    <%!-- SEO Meta Tags --%>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />

    <%!-- Open Graph Meta Tags --%>
    <meta
      :if={assigns[:page_title]}
      property="og:title"
      content={"#{@page_title} · Personal Brand"}
    />
    <meta :if={assigns[:meta_description]} property="og:description" content={@meta_description} />
    <meta :if={assigns[:og_image]} property="og:image" content={@og_image} />
    <meta :if={assigns[:og_type]} property="og:type" content={@og_type} />
    <meta property="og:site_name" content="Nunu Nugraha" />

    <%!-- Twitter Card Meta Tags --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      :if={assigns[:page_title]}
      name="twitter:title"
      content={"#{@page_title} · Personal Brand"}
    />
    <meta :if={assigns[:meta_description]} name="twitter:description" content={@meta_description} />
    <meta :if={assigns[:og_image]} name="twitter:image" content={@og_image} />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
