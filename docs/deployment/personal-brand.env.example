# Copy to /home/nunuadmin/personal-brand-platform/.env on the VPS.
# Do not commit real values.

MIX_ENV=prod
PHX_SERVER=true
PORT=4000
PHX_HOST=YOUR_DOMAIN
POOL_SIZE=10
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Generate with:
# cd personal_brand && mix phx.gen.secret
SECRET_KEY_BASE=REPLACE_WITH_SECRET

# Example:
# ecto://personal_brand_user:STRONG_PASSWORD@localhost/personal_brand_prod
DATABASE_URL=ecto://personal_brand_user:REPLACE_WITH_PASSWORD@localhost/personal_brand_prod

# Persistent uploads directory. Nginx should serve /uploads/ from this path.
UPLOADS_DIR=/home/nunuadmin/personal-brand-shared/uploads

# Midtrans.
MIDTRANS_SERVER_KEY=REPLACE_WITH_MIDTRANS_SERVER_KEY
MIDTRANS_ENV=sandbox

# Paid order email notifications.
PAYMENT_NOTIFICATION_TO=r.fajarnugraha@gmail.com
PAYMENT_NOTIFICATION_FROM="Personal Brand <no-reply@YOUR_DOMAIN>"
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
