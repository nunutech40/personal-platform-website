# Copy to /opt/personal-brand/.env.production on the target server.
# Never commit the real file. This template is for Docker production deploy.
PHX_HOST=nunugraha.web.id
IMAGE_TAG=latest

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_url_safe_hex_secret
# Generate with: cd personal_brand && mix phx.gen.secret
SECRET_KEY_BASE=replace_with_phoenix_secret_key_base
POOL_SIZE=5

ADMIN_USERNAME=nunuops
ADMIN_PASSWORD=replace_with_admin_password

UPLOADS_DIR=/app/uploads

MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox
PAYMENT_NOTIFICATION_TO=r.fajarnugraha@gmail.com
PAYMENT_NOTIFICATION_FROM=Personal Brand <no-reply@nunugraha.web.id>

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
